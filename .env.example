# Lenovo Vibe Stage · 环境变量样板
# 复制为 .env 后再修改：cp .env.example .env

# 对外端口（浏览器访问的端口）
PUBLIC_PORT=8080

# PostgreSQL 凭据（生产请务必改强密码）
POSTGRES_USER=roster
POSTGRES_PASSWORD=roster_pwd
POSTGRES_DB=roster

# 宿主机的局域网 IP（手机扫码二维码用）
# Mac:    LAN_IP=$(ipconfig getifaddr en0)
# Linux:  LAN_IP=$(hostname -I | awk '{print $1}')
# 留空则前端会回退到 window.location.hostname，仅本机访问可用
LAN_IP=

# 云端（本地 docker compose 可忽略；有值时优先于上面的 PG*）
# DATABASE_URL=postgresql://user:pass@host:5432/roster
